# Configuration HDFS, partagée par le namenode et le datanode.
# Format : <FICHIER>.XML_<paramètre>=<valeur>
# Au démarrage, l'image convertit ces lignes en vrais fichiers core-site.xml / hdfs-site.xml.
# (Inspiré de l'exemple officiel : github.com/apache/hadoop, branche docker-hadoop-3, sans YARN)

# Adresse du système de fichiers : "hdfs://namenode:8020/..." (8020 = port RPC du NameNode)
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

# Un seul DataNode → une seule copie de chaque bloc (3 par défaut sur un vrai cluster)
HDFS-SITE.XML_dfs.replication=1

# Où le NameNode range son "sommaire" et où le DataNode range les blocs (dans les volumes Docker)
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data

# Prototype local : pas de gestion des droits Unix dans HDFS (tout le monde peut écrire partout)
HDFS-SITE.XML_dfs.permissions.enabled=false

# Les clients (Mage, Spark) contactent le DataNode par son nom "datanode" plutôt que par une IP interne
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
