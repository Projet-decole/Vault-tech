# Copier ce fichier en .env et adapter les valeurs.
# .env n'est jamais commité (voir .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=homepedia
# Port exposé sur la machine hôte (changer si 5432 est déjà pris)
POSTGRES_PORT=5432

# --- Superset ---
# Clé de chiffrement interne (générer avec : openssl rand -base64 42)
SUPERSET_SECRET_KEY=change-moi
# Mot de passe du compte "admin" de Superset (http://localhost:8088)
SUPERSET_ADMIN_PASSWORD=change-moi

# --- MongoDB (phase bonus) ---
MONGO_ROOT_USER=homepedia
MONGO_ROOT_PASSWORD=change-moi
# Accès à l interface mongo-express (http://localhost:8082)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-moi

# --- Stockage de fichiers S3 / SeaweedFS (phase bonus) ---
S3_ACCESS_KEY=homepedia
S3_SECRET_KEY=change-moi
# Interface d administration SeaweedFS (http://localhost:23646), utilisateur "admin"
SEAWEEDFS_ADMIN_PASSWORD=change-moi
